    {
      "parameters": {
        "jsCode": "\nconst rows = $input.all();\n\nconst toNumber = (value) => {\n  const n = Number(value ?? 0);\n  return Number.isFinite(n) ? n : 0;\n};\n\nconst hourlyData = {};\nlet skippedRows = 0;\n\nfor (const item of rows) {\n  const row = item.json;\n\n  const rawTime =\n    row[\"Jam Posting\"] ??\n    row[\"Jam Tayang\"] ??\n    row[\"Waktu Posting\"] ??\n    row[\"Waktu\"] ??\n    row[\"Jam\"];\n\n  let hour;\n\n  // Format jam berupa angka, misalnya 9 atau 18.\n  if (\n    typeof rawTime === \"number\" ||\n    /^\\s*\\d{1,2}\\s*$/.test(String(rawTime ?? \"\"))\n  ) {\n    hour = Number(rawTime);\n  } else {\n    // Format teks, misalnya 09:00 atau tanggal + jam.\n    const match = String(rawTime ?? \"\").match(\n      /\\b(\\d{1,2}):(\\d{2})(?::\\d{2})?\\b/\n    );\n\n    if (!match) {\n      skippedRows++;\n      continue;\n    }\n\n    hour = Number(match[1]);\n  }\n\n  if (!Number.isInteger(hour) || hour < 0 || hour > 23) {\n    skippedRows++;\n    continue;\n  }\n\n  const time = `${String(hour).padStart(2, \"0\")}:00`;\n\n  const likes = toNumber(row[\"Likes\"] ?? row[\"Like\"]);\n  const comments = toNumber(row[\"Comments\"] ?? row[\"Comment\"]);\n  const shares = toNumber(row[\"Shares\"] ?? row[\"Share\"]);\n\n  // Engagement Score = Likes + (Comments x 2) + (Shares x 3)\n  const engagementScore = likes + comments * 2 + shares * 3;\n\n  if (!hourlyData[time]) {\n    hourlyData[time] = {\n      jam_posting: time,\n      jumlah_postingan: 0,\n      total_likes: 0,\n      total_comments: 0,\n      total_shares: 0,\n      total_engagement: 0\n    };\n  }\n\n  const group = hourlyData[time];\n\n  group.jumlah_postingan++;\n  group.total_likes += likes;\n  group.total_comments += comments;\n  group.total_shares += shares;\n  group.total_engagement += engagementScore;\n}\n\nconst groups = Object.values(hourlyData);\n\nif (groups.length === 0) {\n  return [{\n    json: {\n      status: \"error\",\n      pesan: \"Tidak ada jam posting yang valid. Periksa kolom Jam Posting.\",\n      jumlah_data_masuk: rows.length,\n      jumlah_baris_dilewati: skippedRows\n    }\n  }];\n}\n\ngroups.sort((a, b) =>\n  (b.total_engagement / b.jumlah_postingan) -\n  (a.total_engagement / a.jumlah_postingan)\n);\n\nreturn groups.slice(0, 5).map((group, index) => ({\n  json: {\n    peringkat: index + 1,\n    jam_posting: group.jam_posting,\n    jumlah_postingan: group.jumlah_postingan,\n    total_likes: group.total_likes,\n    total_comments: group.total_comments,\n    total_shares: group.total_shares,\n    total_engagement: group.total_engagement,\n    rata_rata_engagement: Number(\n      (group.total_engagement / group.jumlah_postingan).toFixed(2)\n    ),\n    jumlah_data_masuk: rows.length,\n    jumlah_baris_dilewati: skippedRows\n  }\n}));\n"
      },
