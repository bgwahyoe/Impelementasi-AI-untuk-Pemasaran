    {
      "parameters": {
        "jsCode": "\nconst items = $input.all();\n\nconst medal = [\"🥇\", \"🥈\", \"🥉\", \"4️⃣\", \"5️⃣\"];\n\nconst hasil = items\n  .sort((a, b) => Number(a.json.peringkat) - Number(b.json.peringkat))\n  .map((item, index) => {\n    const d = item.json;\n\n    return `${medal[index] || \"📍\"} JAM ${d.jam_posting}\n\n   📊 Rata-rata Engagement : ${Number(d.rata_rata_engagement).toLocaleString(\"id-ID\")}\n   📝 Jumlah Postingan     : ${d.jumlah_postingan}\n   ❤️ Total Likes          : ${Number(d.total_likes).toLocaleString(\"id-ID\")}\n   💬 Total Comments       : ${Number(d.total_comments).toLocaleString(\"id-ID\")}\n   🔁 Total Shares         : ${Number(d.total_shares).toLocaleString(\"id-ID\")}\n   ⚡ Total Engagement     : ${Number(d.total_engagement).toLocaleString(\"id-ID\")}`;\n  })\n  .join(\"\\n\\n━━━━━━━━━━━━━━━━━━\\n\\n\");\n\nconst terbaik = items\n  .slice()\n  .sort((a, b) =>\n    Number(b.json.rata_rata_engagement) -\n    Number(a.json.rata_rata_engagement)\n  )[0]?.json;\n\nconst pesan = `📊 RINGKASAN ANALISIS ENGAGEMENT\n━━━━━━━━━━━━━━━━━━\n\n👋 Halo! Berikut hasil analisis jam posting terbaik berdasarkan data yang telah diolah.\n\n🏆 TOP 5 JAM POSTING TERBAIK\n\n${hasil}\n\n━━━━━━━━━━━━━━━━━━\n💡 REKOMENDASI\n\n🚀 Prioritaskan jam ${terbaik?.jam_posting || \"-\"} karena memiliki rata-rata engagement tertinggi, yaitu ${Number(terbaik?.rata_rata_engagement || 0).toLocaleString(\"id-ID\")}.\n\n📌 Gunakan hasil ini sebagai acuan untuk menyusun jadwal konten berikutnya. Evaluasi secara berkala agar strategi posting tetap sesuai dengan respons audiens.\n\n🤖 Laporan dibuat otomatis menggunakan n8n.\n`;\n\nreturn [\n  {\n    json: {\n      telegram_message: pesan\n    }\n  }\n];\n"
      },
