    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Menggunakan DateTime bawaan n8n \nconst now = DateTime.now().setZone('Asia/Jakarta');\nconst postsToSend = [];\n\nfor (const item of items) {\n  const row = item.json;\n  \n  const dateStr = row['Scheduled Date'];\n  const timeStr = row['Scheduled Time'];\n\n  // PERBAIKAN: Gunakan .toLowerCase() untuk mengabaikan huruf besar/kecil\n  // Pastikan row.Status ada (tidak kosong) sebelum di-lowercase\n  if (row.Status && row.Status.toLowerCase() === 'pending' && dateStr && timeStr) {\n    \n    // Gabungkan tanggal dan waktu dengan spasi (bukan 'T')\n    const dateTimeString = `${dateStr} ${timeStr}`;\n    \n    // Gunakan fromFormat, karena format di Sheet Anda DD/MM/YYYY\n    const scheduledTime = DateTime.fromFormat(dateTimeString, 'dd/MM/yyyy H:mm:ss', { zone: 'Asia/Jakarta' });\n\n    // Cek validitas waktu & apakah sudah waktunya post\n    if (scheduledTime.isValid && scheduledTime <= now) {\n      postsToSend.push(item);\n    }\n  }\n}\n\nreturn postsToSend;"
      },
