    {
      "parameters": {
        "jsCode": "\nconst item = $input.first().json;\nconst meta = $('Siapkan Prompt Ide').first().json;\n\nconst ideList = [\n  {\n    waktu: item.time_slot_1,\n    judul: item.title_1,\n    platform: item.platforms_1,\n    fokus: item.focus_1,\n    ide: item.ideas_1,\n  },\n  {\n    waktu: item.time_slot_2,\n    judul: item.title_2,\n    platform: item.platforms_2,\n    fokus: item.focus_2,\n    ide: item.ideas_2,\n  },\n  {\n    waktu: item.time_slot_3,\n    judul: item.title_3,\n    platform: item.platforms_3,\n    fokus: item.focus_3,\n    ide: item.ideas_3,\n  },\n  {\n    waktu: item.time_slot_4,\n    judul: item.title_4,\n    platform: item.platforms_4,\n    fokus: item.focus_4,\n    ide: item.ideas_4,\n  },\n];\n\nconst daftarIde = ideList.map((ide, index) => {\n  return [\n    `💡 IDE KONTEN ${index + 1}`,\n    `⏰ Waktu: ${ide.waktu || '-'}`,\n    `📌 Judul: ${ide.judul || '-'}`,\n    `📱 Platform: ${ide.platform || '-'}`,\n    `🎯 Fokus: ${ide.fokus || '-'}`,\n    '',\n    '📝 Rincian:',\n    ide.ide || '-',\n  ].join('\\n');\n});\n\nconst pesan = [\n  '📅 RENCANA IDE KONTEN HARIAN',\n  '━━━━━━━━━━━━━━━━━━',\n  `Tanggal: ${meta.tanggal || '-'}`,\n  `Tema: ${meta.tema || '-'}`,\n  `Waktu dibuat: ${meta.waktu || '-'} WIB`,\n  '',\n  ...daftarIde.flatMap((ide) => [ide, '━━━━━━━━━━━━━━━━━━']),\n  '🤖 Dibuat otomatis dengan n8n',\n].join('\\n');\n\nreturn [{\n  json: {\n    tanggal: meta.tanggal,\n    tema: meta.tema,\n    waktu: meta.waktu,\n    pesan_telegram: pesan,\n    jumlah_ide: ideList.length,\n  },\n}];\n"
      },
